VITE_APP_ENVIRONMENT="development"
# Empty in development: /api is proxied to the backend by Vite.
# Set to the API origin (e.g. https://api.example.com) for production builds.
VITE_API_URL=""
# Supabase project URL and publishable anonymous key (Project Settings → API).
# The service-role key must never appear here.
VITE_SUPABASE_URL="https://example.supabase.co"
VITE_SUPABASE_ANON_KEY="replace-with-publishable-anonymous-key"
