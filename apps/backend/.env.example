# Runtime environment: development | test | production
NODE_ENV="development"

# HTTP port the server listens on
PORT="3000"

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Allowed CORS origin(s). Use "*" for any, or a comma-separated list of origins.
CORS_ORIGIN="*"

# Rate limiter: window length (ms) and max requests per window per IP
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# Trust x-forwarded-* headers. Enable ("true") only when behind a trusted
# reverse proxy / load balancer; leave "false" when directly exposed.
TRUST_PROXY="false"

# PostgreSQL connection string used by Prisma. Required in production; falls
# back to a local Docker instance (`pnpm db:up`) in development/test if unset.
#
# The application database lives in the shared Supabase project, reached
# through its session-mode pooler on :5432 (Prisma migrations work over it).
# The `schema=daedalus2` parameter keeps Prisma's tables and its migration
# history in a dedicated Postgres schema, apart from the tables other apps
# keep in `public` on the same project.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=daedalus2"
# Local Docker fallback (also the default when DATABASE_URL is unset):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/express_api?schema=public"

# Supabase project URL. Access tokens are verified against the JWKS it
# publishes at /auth/v1/.well-known/jwks.json; no secret is needed here.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Secret that signs the Member tokens the Field uses (HS256, see ADR-0009).
# Required; at least 32 characters. Generate one with `openssl rand -hex 32`.
MEMBER_TOKEN_SECRET="<at-least-32-random-characters>"
